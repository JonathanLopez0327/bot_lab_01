# Copia este archivo a .env y ajusta los valores.
# El .env se carga automáticamente (python-dotenv).

# ----------------------------------------------------------------------------
# FEATURE FLAG: elige el proveedor de LLM. El chatbot SIEMPRE usa un LLM;
# el determinismo viene del pipeline + las reglas duras del prompt.
#   claude | openai | google | minimax -> SDK del proveedor (requiere API key
#                                         + pip install -r requirements-llm.txt)
#   fake -> doble de prueba: sin red, sin claves, respuesta fija
#           (tests, CI y demos; es el único que corre "out of the box")
# ----------------------------------------------------------------------------
LLM_PROVIDER=claude

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.0-flash

# --- MiniMax (API compatible con OpenAI; reutiliza el SDK openai) ---
# MINIMAX_API_KEY=...
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3

# Temperatura para openai/google/minimax (Claude Opus no acepta temperature).
# 0 reduce la variabilidad pero NO garantiza determinismo total.
# LLM_TEMPERATURE=0
