# Copia este archivo a .env y ajusta los valores.
# El .env se carga automáticamente (python-dotenv).

# ----------------------------------------------------------------------------
# FEATURE FLAG: elige el "cerebro" del chatbot.
#   deterministic  -> sin LLM, sin claves, 100% reproducible (DEFAULT del lab)
#   claude | openai | google | minimax -> usa el SDK del proveedor (requiere API key)
# ----------------------------------------------------------------------------
LLM_PROVIDER=deterministic

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.0-flash

# --- MiniMax (API compatible con OpenAI; reutiliza el SDK openai) ---
# MINIMAX_API_KEY=...
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3

# Temperatura para openai/google (Claude Opus no acepta temperature).
# 0 reduce la variabilidad pero NO garantiza determinismo total.
# LLM_TEMPERATURE=0
